{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "items": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "checklist"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "project_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "content_markdown": {
            "default": "",
            "type": "string",
            "maxLength": 100000
          },
          "owner": {
            "type": "string",
            "maxLength": 200
          },
          "checklist": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "frequency": {
                    "type": "string",
                    "const": "once"
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "timezone": {
                    "default": "Asia/Shanghai",
                    "type": "string",
                    "const": "Asia/Shanghai"
                  }
                },
                "required": [
                  "frequency",
                  "date"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "frequency": {
                    "type": "string",
                    "enum": [
                      "daily",
                      "weekdays"
                    ]
                  },
                  "start_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "timezone": {
                    "default": "Asia/Shanghai",
                    "type": "string",
                    "const": "Asia/Shanghai"
                  }
                },
                "required": [
                  "frequency",
                  "start_date"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "frequency": {
                    "type": "string",
                    "const": "weekly"
                  },
                  "start_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "weekdays": {
                    "minItems": 1,
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  },
                  "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "timezone": {
                    "default": "Asia/Shanghai",
                    "type": "string",
                    "const": "Asia/Shanghai"
                  }
                },
                "required": [
                  "frequency",
                  "start_date",
                  "weekdays"
                ],
                "additionalProperties": false
              }
            ]
          },
          "reminder": {
            "default": {
              "popup": false,
              "snooze_minutes": 10
            },
            "type": "object",
            "properties": {
              "popup": {
                "default": false,
                "type": "boolean"
              },
              "snooze_minutes": {
                "default": 10,
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "schedule"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false
}
