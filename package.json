{
  "name": "kanban-local",
  "version": "0.4.2",
  "private": true,
  "description": "本地工作看板",
  "author": "Kanban",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "build:web": "npm run schema:rust && npm run typecheck && vite build",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "tauri dev",
    "start:electron": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.rust.config.ts",
    "test:electron-baseline": "npm run build:electron && playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features test-harness --bin store-probe",
    "test:harness": "cargo build --manifest-path src-tauri/Cargo.toml --features test-harness --bin store-probe",
    "test:compat": "tsx scripts/check-rust-compat.ts",
    "schema": "tsx scripts/schema.ts",
    "prepare:electron": "node -e \"require('electron')\"",
    "dist": "tauri build --bundles nsis",
    "pack": "tauri build --no-bundle",
    "schema:workflow": "tsx scripts/workflow-schema.ts",
    "schema:project": "tsx scripts/project-schema.ts",
    "schema:rust": "tsx scripts/rust-schema.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "local.kanban.desktop",
    "productName": "Kanban",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "toolsets": {
      "nsis": "1.2.1",
      "winCodeSign": "1.1.0"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signExecutable": false,
      "artifactName": "Kanban-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
