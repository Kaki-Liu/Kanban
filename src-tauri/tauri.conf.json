{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanban",
  "version": "0.4.1",
  "identifier": "local.kanban.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../out/web"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost", "capabilities": ["desktop"] }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../resources/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type":"downloadBootstrapper", "silent": true},
      "nsis": {"installMode":"currentUser", "languages":["SimpChinese"], "displayLanguageSelector":false}
    }
  }
}
